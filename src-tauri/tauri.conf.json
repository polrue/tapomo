{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tapomo",
  "identifier": "app.tapomo.tracker",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Tapomo",
        "width": 980,
        "height": 780,
        "minWidth": 640,
        "minHeight": 560,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost https://api.tapomo.app"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEYyMTQ2NDI5RkU0QTlBQUUKUldTdW1rcitLV1FVOG5VQm4xdU83L0g4aEMrSy9ZN1BMZ09JSkQ3QmQ1aHBFckhDc1duNWVhbEIK",
      "endpoints": ["https://github.com/polrue/tapomo/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Pol Rue",
    "copyright": "Copyright (C) Pol Rue. GPL-3.0-or-later.",
    "license": "GPL-3.0-or-later",
    "shortDescription": "Passive typing speed tracker",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "template": "installer/installer.nsi",
        "headerImage": "installer/header.bmp",
        "sidebarImage": "installer/sidebar.bmp",
        "languages": ["Spanish", "English"],
        "displayLanguageSelector": false,
        "installMode": "currentUser"
      }
    }
  }
}
